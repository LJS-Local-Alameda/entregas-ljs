rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Plantilla. Los correos reales NO se escriben en este repositorio (es público):
    // se pegan directamente en Firebase > Firestore Database > Reglas.
    // Escribe los correos en minúsculas.
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'correo1@ejemplo.com',
          'correo2@ejemplo.com',
          'correo3@ejemplo.com',
          'correo4@ejemplo.com',
          'correo5@ejemplo.com'
        ];
    }

    match /pedidos/{pedidoId} {
      allow read: if autorizado();
      allow create, update: if autorizado();
      // La página no borra pedidos: se anulan.
      allow delete: if false;
    }
  }
}
